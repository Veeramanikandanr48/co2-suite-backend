<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Email Verification</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background-color: #f4f4f4;
        }

        .container {
            max-width: 600px;
            margin: 30px auto;
            padding: 20px;
            background-color: #ffffff;
            border-radius: 8px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        h2 {
            color: #333;
            font-size: 24px;
            margin-bottom: 10px;
        }

        p {
            color: #555;
            line-height: 1.6;
        }

        .verification-link {
            display: inline-block;
            padding: 10px 20px;
            font-size: 16px;
            color: #ffffff;
            background-color: #007bff;
            text-decoration: none;
            border-radius: 4px;
            margin-top: 10px;
        }

        .verification-link:hover {
            background-color: #0056b3;
        }

        .footer {
            margin-top: 30px;
            color: #777;
        }

        .footer p {
            margin: 5px 0;
        }
    </style>
</head>

<body>
    <div class="container">
        <h2>Email Verification</h2>
        <p>Dear {{name}},</p>
        <p>Thank you for registering. To complete your registration, please click the link below to verify your email address:</p>
        <a href="{{url}}" class="verification-link">Verify Your Email</a>
        {{!-- <p>Your verification OTP: {{otp}}</p> --}}
        <p>If you did not request this verification, please disregard this email.</p>
        <div class="footer">
            <p>Best regards,</p>
            <p>CO2 Suite</p>
        </div>
    </div>
</body>

</html>
